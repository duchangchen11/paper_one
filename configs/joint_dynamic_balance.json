{
  "method": "DGB-20",
  "trajectory_weight_mode": "dynamic_gradient",
  "initial_lambda": 100.0,
  "target_weighted_gradient_ratio": 20.0,
  "log_space_ema_beta": 0.9,
  "lambda_min": 10.0,
  "lambda_max": 300.0,
  "warmup_epochs": 1,
  "update_interval_training_batches": 10,
  "gradient_epsilon": 1e-12,
  "shared_parameter_prefixes": [
