    "epochs": 15,
    "batch_size": 512,
    "hidden_dim": 128,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "prior_weight": 0.5,
    "ambiguous_weight": 0.2,
    "gate_mode": "uncertainty",
